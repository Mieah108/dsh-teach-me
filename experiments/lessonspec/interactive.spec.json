{
  "schemaVersion": 1,
  "id": "spec-interactive-0003",
  "meta": {
    "serial": "0003",
    "course": "课程 · 数据直觉",
    "eyebrow": "第 3 课 · 参数与读数",
    "title": "拖动一个参数，读数怎么变",
    "lede": "这一课只有一件事：亲手调一个参数，看着读数移动，然后说出\"变化方向与幅度\"这件事能不能用一句话讲完。"
  },
  "sections": [
    {
      "id": "s1",
      "title": "一、先记住三张卡",
      "blocks": [
        {
          "kind": "p",
          "text": "下面三张闪卡是本课要用的三个判断。先自己回忆，再翻面核对；翻过答案不等于掌握。"
        }
      ]
    },
    {
      "id": "s2",
      "title": "二、亲手调一次",
      "blocks": [
        {
          "kind": "p",
          "text": "下面这张图里有两组读数。用图下方的控件把\"情境 B\"的读数从 8 调到 4，观察两组柱子的相对高度怎样变化。"
        },
        {
          "kind": "callout",
          "text": "判断标准：读数减半时，柱子高度也减半；比例关系不变，改变的是绝对量。"
        }
      ]
    },
    {
      "id": "s3",
      "title": "三、把观察写成一句可检验的话",
      "blocks": [
        {
          "kind": "list",
          "ordered": true,
          "items": [
            "先说方向：调小 B，B 与 A 的比值变小。",
            "再说幅度：B 减半，比值也减半（线性关系）。",
            "最后说边界：读数不能为负，调到 0 时组件显示\"暂无占比\"而不是画一根负柱。"
          ]
        },
        {
          "kind": "p",
          "text": "这三句合起来就是可检验的结论：换一组数，只要关系不变，结论就仍然成立。"
        }
      ]
    },
    {
      "id": "check",
      "kind": "quiz",
      "title": "验收",
      "questions": [
        {
          "questionId": "q-0003-1",
          "type": "choice",
          "prompt": "把情境 B 的读数从 8 调到 4，情境 A 保持 4 不变。按本课的观察，A 与 B 的比值怎样变化？",
          "scope": "口径：比值按\"情境 A ÷ 情境 B\"计算，调之前 B 为 8。",
          "explain": "调之前比值为 4/8 = 0.5，调之后为 4/4 = 1，比值翻倍。",
          "options": [
            {
              "id": "a",
              "text": "比值不变"
            },
            {
              "id": "b",
              "text": "比值翻倍"
            },
            {
              "id": "c",
              "text": "比值减半"
            }
          ],
          "answer": "b"
        },
        {
          "questionId": "q-0003-2",
          "type": "explanation",
          "prompt": "为什么读数调到 0 时组件显示\"暂无占比\"，而不是画出长度为 0 的柱子？",
          "scope": "口径：回答要区分\"数值为 0\"与\"没有可比较的比例\"这两件事。",
          "rubric": [
            {
              "id": "zero",
              "text": "指出全部读数为 0 时比例没有定义，画图会给出虚假信息"
            },
            {
              "id": "display",
              "text": "说明界面用文案替代图形，避免把\"无定义\"画成\"零\""
            }
          ]
        }
      ]
    }
  ],
